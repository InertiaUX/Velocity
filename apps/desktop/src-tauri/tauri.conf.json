{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Velocity",
  "version": "0.1.1",
  "identifier": "com.inertiaux.velocity",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && bash ../../scripts/copy-plugins.sh",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Velocity",
        "width": 360,
        "height": 740,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "center": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: asset: https: http://127.0.0.1:* http://localhost:*; img-src 'self' data: https: blob: asset: http://asset.localhost; connect-src 'self' https: http://127.0.0.1:* http://localhost:*; frame-src 'self' https: http://127.0.0.1:* http://localhost:* data: blob:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/wallpapers/**",
          "$APPDATA/tile-icons/**",
          "$APPDATA/**",
          "$HOME/Library/Application Support/com.inertiaux.velocity/wallpapers/**",
          "$HOME/Library/Application Support/com.inertiaux.velocity/tile-icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "resources": [
      "resources/plugins/**/*"
    ]
  },
  "plugins": {}
}
